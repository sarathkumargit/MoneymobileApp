<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_app_icon"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="MoneyMobile"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device enrollment"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authorized staff use only"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- Device Owner Status -->
        <TextView
            android:id="@+id/tvDeviceOwnerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:padding="12dp"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Enrollment token" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_field"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:hint="Enter token from dashboard"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:inputType="text"
            android:textSize="14sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shop ID" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etShopId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_field"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:hint="Shop identifier"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:inputType="text"
            android:textSize="14sp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Agreement ID (optional)" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etAgreementId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_field"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:hint="Link to installment agreement"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:inputType="text"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnEnroll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Enroll this device"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
