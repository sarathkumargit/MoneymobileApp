<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvShopName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MoneyMobile" android:textColor="@color/text_secondary"
            android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:layout_marginTop="28dp" android:layout_marginBottom="24dp" />

        <ImageView
            android:layout_width="84dp" android:layout_height="84dp"
            android:background="@drawable/bg_icon_lock"
            android:padding="22dp"
            android:src="@drawable/ic_lock_filled"
            android:contentDescription="Phone locked"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Device restricted" android:textColor="@color/text_primary"
            android:textSize="28sp" android:textStyle="bold" android:letterSpacing="-0.02"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSubReason"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Installment payment required"
            android:textColor="@color/text_secondary" android:textSize="17sp"
            android:layout_marginBottom="24dp" />

        <!-- Balance -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card"
            android:paddingHorizontal="16dp" android:paddingVertical="14dp"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Outstanding balance" android:textColor="@color/text_secondary"
                android:textSize="13sp" />
            <TextView android:id="@+id/tvBalance"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/text_primary"
                android:textSize="34sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="12dp" />

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="@color/separator" android:layout_marginBottom="12dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Overdue" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvOverdue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/danger" android:textSize="17sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Next due" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvNextDue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textColor="@color/text_primary" android:textSize="17sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvContactInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="16dp" android:paddingVertical="14dp"
            android:text="To restore access, please complete your payment. Your device unlocks automatically once the payment is verified."
            android:textColor="@color/text_primary" android:textSize="15sp" android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Connection: shows whether the phone can reach the shop, and lets the customer join
             Wi-Fi even though Settings is hidden (the Unlock arrives over the internet). -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card"
            android:paddingHorizontal="16dp" android:paddingVertical="12dp"
            android:layout_marginBottom="24dp">
            <TextView
                android:id="@+id/tvNetStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Checking connection…" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:gravity="center"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWifi"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="Connect to Wi-Fi" android:textSize="17sp"
                android:textAllCaps="false" android:textColor="@color/primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Pay now -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Pay now" android:textSize="17sp"
            android:textAllCaps="false" android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary" app:cornerRadius="14dp"
            android:stateListAnimator="@null" app:elevation="0dp"
            android:layout_marginBottom="10dp" />

        <!-- Call + message -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallShop"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                android:text="Call shop" android:textSize="17sp"
                android:textAllCaps="false" android:fontFamily="sans-serif-medium"
                android:textColor="@color/primary"
                app:backgroundTint="@color/surface" app:cornerRadius="14dp"
                android:stateListAnimator="@null" app:elevation="0dp"
                android:layout_marginEnd="5dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSmsShop"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                android:text="Message" android:textSize="17sp"
                android:textAllCaps="false" android:fontFamily="sans-serif-medium"
                android:textColor="@color/primary"
                app:backgroundTint="@color/surface" app:cornerRadius="14dp"
                android:stateListAnimator="@null" app:elevation="0dp"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <!-- Offline unlock: 6-digit code from the shop, checked on the phone (no internet needed) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnterCode"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Enter unlock code" android:textSize="17sp"
            android:textAllCaps="false" android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/fill" app:cornerRadius="14dp"
            android:stateListAnimator="@null" app:elevation="0dp"
            android:layout_marginTop="10dp" />

        <!-- Request unlock (customer -> shop) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestUnlock"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Request unlock from shop" android:textSize="17sp"
            android:textAllCaps="false" android:textColor="@color/primary"
            app:cornerRadius="14dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvHotline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/primary" android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvSyncInfo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_muted" android:textSize="11sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
