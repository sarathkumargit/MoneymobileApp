<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <!-- Large title + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MoneyMobile" android:textColor="@color/text_primary"
                    android:textSize="34sp" android:textStyle="bold"
                    android:letterSpacing="-0.02" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Installment account" android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:backgroundTint="@color/tint_success"
                android:text="● Active" android:textColor="@color/success"
                android:textSize="13sp" android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp" android:paddingVertical="6dp" />
        </LinearLayout>

        <!-- Account -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:paddingHorizontal="16dp" android:paddingVertical="14dp"
            android:layout_marginBottom="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Account holder" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/text_primary"
                android:textSize="20sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tvDeviceModel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Registered device" android:textColor="@color/text_secondary"
                android:textSize="15sp" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/tvAgreementLine"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Connecting…"
                android:textColor="@color/success" android:textSize="15sp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Remaining balance -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_balance" android:orientation="vertical"
            android:paddingHorizontal="16dp" android:paddingVertical="16dp"
            android:layout_marginBottom="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Remaining balance" android:textColor="@color/text_secondary"
                android:textSize="13sp" />
            <TextView android:id="@+id/tvRemainingBalance"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/text_primary"
                android:textSize="40sp" android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:layout_marginTop="2dp" android:layout_marginBottom="14dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressPaid"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:progress="0"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                app:indicatorColor="@color/primary"
                app:trackColor="@color/track"
                android:layout_marginBottom="8dp" />

            <TextView android:id="@+id/tvPaidOfTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <!-- Auto-lock deadline: shown only while a payment deadline is pending (works offline) -->
        <LinearLayout
            android:id="@+id/cardLockTime"
            android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:paddingHorizontal="16dp" android:paddingVertical="14dp"
            android:layout_marginBottom="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Phone will lock on" android:textColor="@color/text_secondary"
                android:textSize="13sp" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tvLockTime"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/warning"
                android:textSize="20sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/tvLockCountdown"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/text_primary" android:textSize="15sp"
                android:layout_marginTop="2dp" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Make your payment before this time to keep your phone unlocked. This works even without internet."
                android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <!-- Details: inset grouped list -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:orientation="vertical"
            android:paddingStart="16dp" android:layout_marginBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Total price"
                    android:textColor="@color/text_primary" android:textSize="17sp" />
                <TextView android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_secondary" android:textSize="17sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/separator" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Initial deposit"
                    android:textColor="@color/text_primary" android:textSize="17sp" />
                <TextView android:id="@+id/tvDeposit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/text_secondary" android:textSize="17sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/separator" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Total paid"
                    android:textColor="@color/text_primary" android:textSize="17sp" />
                <TextView android:id="@+id/tvTotalPaid"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/success" android:textSize="17sp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/separator" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingEnd="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Next due date"
                    android:textColor="@color/text_primary" android:textSize="17sp" />
                <TextView android:id="@+id/tvNextDue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="@color/warning" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Unlock phone" android:textSize="17sp"
            android:textAllCaps="false" android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_primary"
            app:icon="@drawable/ic_lock_open" app:iconGravity="textStart" app:iconPadding="8dp"
            app:iconTint="@color/on_primary"
            app:backgroundTint="@color/primary" app:cornerRadius="14dp"
            android:stateListAnimator="@null" app:elevation="0dp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayment"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:text="Payment" android:textSize="17sp"
            android:textAllCaps="false" android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary"
            app:icon="@drawable/ic_card" app:iconGravity="textStart" app:iconPadding="8dp"
            app:iconTint="@color/primary"
            app:backgroundTint="@color/surface" app:cornerRadius="14dp"
            android:stateListAnimator="@null" app:elevation="0dp"
            android:layout_marginBottom="24dp" />

        <!-- Call & message -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginBottom="12dp">

            <LinearLayout android:id="@+id/btnCall"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp">
                <ImageView
                    android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/bg_icon_circle" android:padding="15dp"
                    android:src="@drawable/ic_call" android:contentDescription="Call shop" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Call shop" android:textColor="@color/primary" android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/btnMessage"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp">
                <ImageView
                    android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/bg_icon_circle" android:padding="15dp"
                    android:src="@drawable/ic_message" android:contentDescription="Message shop" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Message" android:textColor="@color/primary" android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/tvFooter"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Syncing with your account…"
            android:textColor="@color/text_secondary" android:textSize="13sp" android:gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
